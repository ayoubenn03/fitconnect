{
  "info": {
    "name": "FitConnect",
    "description": "TP microservices EFRIE M2-DEV1 — class-service / booking-service (orchestrateur Saga) / payment-service / notification-service, appelés via api-gateway (:8080). Toutes les requêtes utilisent la variable de collection {{gatewayUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "classId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "limitedClassId", "value": "" },
    { "key": "cancelFlowClassId", "value": "" },
    { "key": "cancelBookingId", "value": "" },
    { "key": "paymentDirectId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "futureDate5", "value": "" },
    { "key": "futureDate7", "value": "" },
    { "key": "futureDate10", "value": "" },
    { "key": "futureDate30", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Recalcule des dates futures a chaque requete (LocalDateTime cote serveur, donc PAS de 'Z' en fin de chaine).",
          "function pad(n) { return n.toString().padStart(2, '0'); }",
          "function isoLocal(daysFromNow, hour) {",
          "  const d = new Date(Date.now() + daysFromNow * 24 * 60 * 60 * 1000);",
          "  d.setHours(hour, 0, 0, 0);",
          "  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':00:00';",
          "}",
          "pm.collectionVariables.set('futureDate5', isoLocal(5, 9));",
          "pm.collectionVariables.set('futureDate7', isoLocal(7, 18));",
          "pm.collectionVariables.set('futureDate10', isoLocal(10, 10));",
          "pm.collectionVariables.set('futureDate30', isoLocal(30, 8));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Class management",
      "item": [
        {
          "name": "Creer un cours (Crossfit, 10 places)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('id present', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.collectionVariables.set('classId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{gatewayUrl}}/api/classes", "host": ["{{gatewayUrl}}"], "path": ["api", "classes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Crossfit intensif\",\n  \"description\": \"Seance de crossfit haute intensite\",\n  \"instructor\": \"Karim\",\n  \"gymLocation\": \"Paris 10e\",\n  \"category\": \"CROSSFIT\",\n  \"level\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 20.00,\n  \"dateTime\": \"{{futureDate10}}\"\n}"
            }
          }
        },
        {
          "name": "Lister les cours (pagination + filtre categorie)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/classes?category=CROSSFIT&page=0&size=10&sort=dateTime,asc",
              "host": ["{{gatewayUrl}}"], "path": ["api", "classes"],
              "query": [
                { "key": "category", "value": "CROSSFIT" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "dateTime,asc" }
              ]
            }
          }
        },
        {
          "name": "Rechercher des cours (niveau + localisation)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/classes/search?level=INTERMEDIATE&location=Paris",
              "host": ["{{gatewayUrl}}"], "path": ["api", "classes", "search"],
              "query": [
                { "key": "level", "value": "INTERMEDIATE" },
                { "key": "location", "value": "Paris" }
              ]
            }
          }
        },
        {
          "name": "Recuperer un cours par id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/classes/{{classId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "classes", "{{classId}}"] }
          }
        },
        {
          "name": "Mettre a jour un cours",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200 OK', () => pm.response.to.have.status(200));" ] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{gatewayUrl}}/api/classes/{{classId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "classes", "{{classId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Crossfit intensif (salle B)\",\n  \"description\": \"Seance de crossfit haute intensite - changement de salle\",\n  \"instructor\": \"Karim\",\n  \"gymLocation\": \"Paris 10e - Salle B\",\n  \"category\": \"CROSSFIT\",\n  \"level\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 22.00,\n  \"dateTime\": \"{{futureDate10}}\"\n}"
            }
          }
        },
        {
          "name": "Creer un cours a annuler",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('classToCancelId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{gatewayUrl}}/api/classes", "host": ["{{gatewayUrl}}"], "path": ["api", "classes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yoga du soir\",\n  \"description\": \"Seance de relaxation\",\n  \"instructor\": \"Nadia\",\n  \"gymLocation\": \"Paris 15e\",\n  \"category\": \"YOGA\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 45,\n  \"maxParticipants\": 12,\n  \"price\": 15.00,\n  \"dateTime\": \"{{futureDate30}}\"\n}"
            }
          }
        },
        {
          "name": "Annuler ce cours",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('204 No Content', () => pm.response.to.have.status(204));" ] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{gatewayUrl}}/api/classes/{{classToCancelId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "classes", "{{classToCancelId}}"] }
          }
        }
      ]
    },
